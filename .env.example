# Copy this file to .env and adjust.

# Folder for your learning data: profile, knowledge map and one folder per session.
# Use an absolute path. Keep it outside this repository so personal notes never get committed.
LEARNING_DIR=~/learning

# Port for the web app's server. In dev mode, also change the proxy in vite.config.ts.
PORT=4318

# Optional: force a model for every session (leave empty to use your Claude Code default).
CLAUDE_MODEL=
